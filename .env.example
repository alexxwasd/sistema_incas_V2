# Puerto local donde se inicia el servidor Express.
PORT=3000

# Credenciales de PostgreSQL para la conexión por variables individuales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_incas
DB_USER=postgres
DB_PASSWORD= Tu contraseña de PostgreSQL
# Se usa para firmar las sesiones; genera un valor aleatorio largo y privado.
SESSION_SECRET=

# Cambia a true solo si PostgreSQL requiere TLS con certificado válido.
DB_SSL=false
